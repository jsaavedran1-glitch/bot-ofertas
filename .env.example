# Base persistente. En producción usa el Session Pooler de Supabase y SSL.
# DATABASE_URL=postgresql://usuario:clave@host.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///ofertas.db

# Mercado Libre OAuth. El refresh token del secret se usa solo para iniciar;
# el par rotado se cifra y persiste en DATABASE_URL.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
# Genera una vez con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
ML_QUERIES=audifonos bluetooth,portatil,celular,televisor,electrodomesticos
ML_LIMIT_PER_QUERY=30

# Feed JSON/CSV autorizado de Amazon, Temu u otros afiliados.
PARTNER_FEED_PATH=feeds/deals.json

# Facebook Page API
FB_PAGE_ID=
FB_PAGE_TOKEN=
META_GRAPH_API_VERSION=v26.0

# review es el modo seguro predeterminado. automatic publica sin aprobación.
POST_MODE=review
MIN_DISCOUNT_PCT=20
MIN_SAVINGS_COP=20000
MAX_POSTS_PER_DAY=5
REPOST_COOLDOWN_DAYS=7
CANDIDATE_MAX_AGE_HOURS=6
HISTORY_MIN_OBSERVATIONS=3
HISTORY_MIN_SPAN_HOURS=168
USD_COP_RATE=
AFFILIATE_DISCLOSURE=true
GENERATED_DIR=generated
